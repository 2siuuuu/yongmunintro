{
  "name": "yongmundong-village",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "preview:pages": "wrangler pages dev dist",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "pages:check": "wrangler pages functions build --outdir .pages-check"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "hono": "4.13.19",
    "jose": "6.2.17",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.8",
    "@tailwindcss/vite": "4.3.5",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "wrangler": "4.163.0"
  }
}
